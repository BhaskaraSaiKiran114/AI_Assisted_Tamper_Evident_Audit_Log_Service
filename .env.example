# Docker Compose reads .env automatically. Spring Boot does not.
# Copy to .env and replace the password before starting PostgreSQL.
AUDIT_ADMIN_PASSWORD=
AUDIT_MIGRATION_PASSWORD=
AUDIT_DB_PASSWORD=
POSTGRES_PORT=5432
# Set these as shell environment variables for the postgres Spring profile:
# SPRING_PROFILES_ACTIVE=postgres
# AUDIT_DB_URL=jdbc:postgresql://localhost:5432/auditlog
# AUDIT_DB_USERNAME=audit_runtime
# AUDIT_DB_PASSWORD=<same password as .env>
# AUDIT_MIGRATION_USERNAME=audit_migrator
# AUDIT_MIGRATION_PASSWORD=<same migration password as .env>
# AUDIT_JWT_PUBLIC_KEY_BASE64=<Base64 X.509 RSA public key; no private key in application>
# AUDIT_JWT_ISSUER=urn:audit-log:local
# AUDIT_JWT_AUDIENCE=audit-log-service
# AUDIT_MASTER_KEY_BASE64=<securely generated 32-byte key, Base64 encoded; preserve across restarts>
# AUDIT_PROTECTED_PATHS=/accountNumber,/personalIdentifier
# AUDIT_CURSOR_KEY_BASE64=<separate 32-byte key for cursors shared across restarts/instances; optional>
# AUDIT_RETENTION_WINDOW=P90D
# AUDIT_RETENTION_POLICY_VERSION=v1
# AUDIT_RETENTION_BATCH_SIZE=100

# Export signing uses a separate private key; no fallback if unconfigured.
# AUDIT_EXPORT_PRIVATE_KEY_BASE64=<Base64 PKCS8 RSA private key; keep outside Git/logs>
# AUDIT_EXPORT_MAX_CONCURRENT=2
# AUDIT_EXPORT_MAX_RECORDS=10000
# AUDIT_EXPORT_MAX_SELECTED=1000
# AUDIT_EXPORT_MAX_BYTES=16777216

# Bounded metadata-only access report (shell environment, not auto-loaded by Spring):
# AUDIT_REPORT_MAX_WINDOW=P31D
# AUDIT_REPORT_MAX_SCANNED=1000
# AUDIT_REPORT_MAX_CONCURRENT=2
